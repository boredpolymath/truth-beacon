{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TruthBeacon",
  "version": "0.1.5",
  "identifier": "com.orangeheartindustries.truthbeacon",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "TruthBeacon — Community Impersonation Protection",
        "width": 1280,
        "height": 840,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; img-src 'self' data: https://cdn.discordapp.com https://images.unsplash.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; connect-src 'self' wss://gateway.discord.gg https://discord.com;"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "hardenedRuntime": true,
      "entitlements": "Entitlements.plist",
      "minimumSystemVersion": "10.15",
      "dmg": {
        "background": "icons/dmg-background.png",
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 200
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 200
        }
      }
    },
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/nsis-header.bmp",
        "sidebarImage": "icons/nsis-sidebar.bmp",
        "installMode": "currentUser",
        "languages": [
          "English"
        ],
        "displayLanguageSelector": false
      },
      "wix": {
        "language": "en-US",
        "bannerPath": "icons/wix-banner.bmp",
        "dialogImagePath": "icons/wix-dialog.bmp"
      }
    },
    "linux": {
      "deb": {
        "section": "utils",
        "priority": "optional",
        "depends": [
          "libwebkit2gtk-4.1-0 | libwebkit2gtk-4.0-37",
          "libappindicator3-1",
          "libsecret-1-0",
          "libxdo3"
        ],
        "files": {
          "/usr/share/metainfo/com.orangeheartindustries.truthbeacon.metainfo.xml": "desktop/com.orangeheartindustries.truthbeacon.metainfo.xml"
        }
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENCREI2NjkwOEY0QjdDOTYKUldTV2ZFdVBrR2JieTZsQjR3YlQxY2YxL1ZvL2ZMTGduWmgzdUs4VWhBQ1ZLZTlWQjNPb0ZxZVEK",
      "endpoints": [
        "https://github.com/boredpolymath/truth-beacon/releases/latest/download/latest.json"
      ]
    }
  }
}
